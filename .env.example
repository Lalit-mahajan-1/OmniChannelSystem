# ─────────────────────────────────────────────
# Docker Compose Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=omnichannel2024

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Gmail OAuth2
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ADDRESS=

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=
WEBHOOK_VERIFY_TOKEN=

# ─── AI Ticket Intelligence ───────────────────
# Option A: OpenAI (primary — used if key is set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_URL=https://api.openai.com/v1/chat/completions  # override for proxies

# Option B: Anthropic Claude (fallback — used if OPENAI_API_KEY is not set)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-haiku-20241022
# CLAUDE_API_URL=https://api.anthropic.com/v1/messages  # override for proxies

# ─── AI Email Reply Agent ─────────────────────
# Groq (free tier) — get key at https://console.groq.com
GROQ_API_KEY=

# ─── Vector Database (Pinecone) ───────────────
PINECONE_API_KEY=
PINECONE_INDEX=omnichannel-memory
PINECONE_ENVIRONMENT=us-east-1

# ─── Redis ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── ML Service ───────────────────────────────
ML_SERVICE_URL=http://ml-service:8000

# ─── Frontend URL ─────────────────────────────
FRONTEND_URL=http://localhost

# ─── SLA Defaults (minutes) ───────────────────
SLA_FIRST_RESPONSE_CRITICAL=15
SLA_FIRST_RESPONSE_HIGH=60
SLA_FIRST_RESPONSE_MEDIUM=240
SLA_RESOLUTION_CRITICAL=240
SLA_RESOLUTION_HIGH=1440

# ─── Monitoring ───────────────────────────────
PROMETHEUS_PORT=9090
LOG_LEVEL=info
LOG_FORMAT=json

# ─── Grafana ──────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin