# ─────────────────────────────────────────────────────────────
# OmniChannel Platform - Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/omnichannel
MONGO_USER=admin
MONGO_PASSWORD=omnichannel2024

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ── Gmail OAuth2 ─────────────────────────────────────────────
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_ADDRESS=your-email@gmail.com

# ── WhatsApp ─────────────────────────────────────────────────
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ── Agent Services ───────────────────────────────────────────
EMPLOYER_MONGO_ID=your-employer-mongo-id
AGENT_SERVICE_KEY=change-me-to-a-random-secret

# ── AI Providers ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
GROQ_API_KEY=your-groq-api-key
OPENAI_API_KEY=your-openai-api-key

# ── Vector Database (Pinecone) ───────────────────────────────
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=omnichannel-memory
PINECONE_ENVIRONMENT=us-east-1

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── ML Service ───────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ── SLA Defaults (minutes) ───────────────────────────────────
SLA_FIRST_RESPONSE_CRITICAL=15
SLA_FIRST_RESPONSE_HIGH=60
SLA_FIRST_RESPONSE_MEDIUM=240
SLA_RESOLUTION_CRITICAL=240
SLA_RESOLUTION_HIGH=1440

# ── Monitoring ───────────────────────────────────────────────
PROMETHEUS_PORT=9090
LOG_LEVEL=info
LOG_FORMAT=json

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
